# 蓝心AI学习伴侣 后端环境变量
# 复制此文件为 .env 并填入真实值
# 不要把此文件提交到 Git（已在 .gitignore 中排除真实 .env）

# ===== 服务配置 =====
PORT=8000

# ===== AI 模式 =====
# true  = 所有接口返回本地 Mock 模板 — 无需任何 Key 即可跑完整主 Demo
# false = 调用真实 LLM（具体由 DEFAULT_MODEL_PROVIDER 决定）
AI_MOCK_MODE=true

# ===== 默认模型提供商 =====
# deepseek = DeepSeek-Chat（默认，指令遵循强，支持 JSON Mode 结构化输出）
# vivo     = 蓝心 AI (blue-lm-v-3b) — 保留原方案作为备选
# mock     = 强制 Mock（等同于 AI_MOCK_MODE=true，仅作语义区分）
DEFAULT_MODEL_PROVIDER=deepseek

# ===== DeepSeek（主力，替换原 VIVO_*）=====
# 文档：https://api.deepseek.com
# 免费额度：注册送 500 万 Token（deepseek-chat，2026 年内有效）
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Qwen-VL（识图，阿里云百炼）=====
# 文档：https://llm-dm4c0m7ddxaxtw51.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# qwen-vl-plus：识图+人脸识别，输入 ¥0.002/千token，输出 ¥0.006/千token
QEWN_API_KEY=YOUR_QEWN_KEY_HERE
QEWN_BASE_URL=https://llm-dm4c0m7ddxaxtw51.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QEWN_MODEL=qwen-vl-plus

# ===== 蓝心 AI（vivo AIGC）— 保留原方案，注释掉 =====
# 文档：https://aigc.vivo.com.cn/#/document/index?id=1677
# VIVO_API_KEY=YOUR_VIVO_KEY_HERE
# VIVO_API_SECRET=
# VIVO_BASE_URL=https://api-ai.vivo.com.cn
# VIVO_MODEL=blue-lm-v-3b
