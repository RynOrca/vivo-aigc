# 蓝心AI学习伴侣 后端环境变量
# 复制此文件为 .env 并填入真实值

# ===== 服务配置 =====
PORT=8000

# ===== AI 模式 =====
# true  = 使用本地 Mock 文案（默认，无需 vivo Key）
# false = 调用蓝心 AI 官方接口（需填写下方 VIVO_* 字段）
AI_MOCK_MODE=true

# ===== 蓝心 AI (vivo AIGC) =====
# 接入文档：https://aigc.vivo.com.cn/#/document/index?id=1677
# 申请地址：https://aigc.vivo.com.cn
VIVO_API_KEY=YOUR_VIVO_KEY_HERE
VIVO_API_SECRET=
VIVO_BASE_URL=https://api-ai.vivo.com.cn

# ===== 模型配置 =====
VIVO_MODEL=blue-lm-v-3b
