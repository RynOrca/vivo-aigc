<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — fullscreen, no action bar -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#db7688</item>
        <item name="colorPrimaryDark">#c96a7a</item>
        <item name="colorAccent">#3f7b73</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#f7f8ec</item>
        <item name="android:statusBarColor">#db7688</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 启动画面：白色背景 + 无延迟（消除黑屏） -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">#f7f8ec</item>
    </style>
</resources>